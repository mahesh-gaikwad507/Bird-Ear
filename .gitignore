.venv/
venv/
env/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# ==========================================
# SECRETS AND LOCAL ENVIRONMENT SETTINGS
# ==========================================
.env
.env.*
!.env.example
secrets.json
credentials.json

# ==========================================
